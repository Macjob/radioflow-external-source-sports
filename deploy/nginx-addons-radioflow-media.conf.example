server {
    listen 443 ssl http2;
    server_name addons.radioflow.media;

    # Reuse the VPS certificate automation; certificate paths are deployment-specific.
    ssl_certificate /etc/letsencrypt/live/addons.radioflow.media/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/addons.radioflow.media/privkey.pem;

    client_max_body_size 64k;

    location = /sports {
        return 308 /sports/;
    }

    location /sports/ {
        proxy_pass http://127.0.0.1:8010/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Prefix /sports;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
}
